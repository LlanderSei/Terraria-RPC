<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TerrariaRPC.Forms.SmallDetailsTemplatesDialog"
        Title="Boss and Event Priority"
        Width="920" Height="420"
        MinWidth="920" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Icon="avares://TerrariaRPC/Assets/icon.png">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="16,16,16,0" Spacing="12">
      <TextBlock Text="Boss and Event Priority" FontWeight="Bold" FontSize="18" />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <Grid Name="PriorityPane" ColumnDefinitions="240,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" Margin="16,8,16,16">
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Bosses" FontWeight="Bold" FontSize="16" Margin="0,0,0,2" />

        <CheckBox Name="PrioritizeLunarPillarsNearbyBox" Grid.Row="1" Grid.ColumnSpan="2" Content="Always prioritize Lunar Pillars if it's nearby, regardless if there are other bosses alive." Margin="20,0,0,0" />

        <CheckBox Name="PrioritizeTargetHitBossBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Prioritize what player is hitting if there are multiple bosses alive." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

        <CheckBox Name="PrioritizeNearestBossBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Prioritize nearest target to the player if there are multiple bosses alive." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

        <CheckBox Name="PrioritizeHighestHealthBossBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Prioritize boss that has the highest health." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

        <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                   Text="The hit-target option is the default. At least one of the three boss priority options stays enabled."
                   TextWrapping="Wrap"
                   Opacity="0.7"
                   Margin="20,4,0,0" />
      </Grid>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="16,0,16,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="OnCancelClick" />
        <Button Name="SaveButton" Content="Save" Click="OnSaveClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
