<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TerrariaRPC.Forms.SmallDetailsTemplatesDialog"
        Title="Customize Small Details"
        Width="920" Height="760"
        MinWidth="920" MinHeight="760"
        WindowStartupLocation="CenterOwner"
        Icon="avares://TerrariaRPC/Assets/icon.png">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="16,16,16,0" Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Small Details Configuration" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Content="? Available Variables"
                FontSize="12"
                Padding="8,4"
                Click="OnVariablesClick" />
      </Grid>

      <TextBlock Text="Use expressions inside double brackets. Supported operators include ? : , ?? , &amp;&amp; , || , == , != , ! and parentheses. Nested {{...}} tokens are resolved before each expression is evaluated."
                 TextWrapping="Wrap"
                 Opacity="0.7" />

      <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
        <ToggleButton Name="PriorityPaneButton"
                      Content="Boss and Event Priority"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="12,8"
                      Click="OnPriorityPaneClick" />
        <ToggleButton Name="TemplatePaneButton"
                      Grid.Column="1"
                      Content="Small Details Template"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center"
                      Padding="12,8"
                      Click="OnTemplatePaneClick" />
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="2">
      <StackPanel Margin="16,4,16,16" Spacing="16">
        <Grid Name="PriorityPane" ColumnDefinitions="240,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" IsVisible="False" Margin="0,8,0,0">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Bosses" FontWeight="Bold" FontSize="16" Margin="0,0,0,2" />

          <CheckBox Name="PrioritizeLunarPillarsNearbyBox" Grid.Row="1" Grid.ColumnSpan="2" Content="Always prioritize Lunar Pillars if it's nearby, regardless if there are other bosses alive." Margin="20,0,0,0" />

          <CheckBox Name="PrioritizeTargetHitBossBox" Grid.Row="2" Grid.ColumnSpan="2" Content="Prioritize what player is hitting if there are multiple bosses alive." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

          <CheckBox Name="PrioritizeNearestBossBox" Grid.Row="3" Grid.ColumnSpan="2" Content="Prioritize nearest target to the player if there are multiple bosses alive." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

          <CheckBox Name="PrioritizeHighestHealthBossBox" Grid.Row="4" Grid.ColumnSpan="2" Content="Prioritize boss that has the highest health." IsCheckedChanged="OnBossPriorityChanged" Margin="20,0,0,0" />

          <TextBlock Grid.Row="5" Grid.ColumnSpan="2"
                     Text="The hit-target option is the default. At least one of the three boss priority options stays enabled."
                     TextWrapping="Wrap"
                     Opacity="0.7"
                     Margin="20,4,0,0" />
        </Grid>

        <Grid Name="TemplatePane" ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" Margin="0,8,0,0">
          <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Small Details Templates" FontWeight="Bold" FontSize="16" Margin="0,0,0,2" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Boss:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Name="BossTemplateBox" Grid.Row="1" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Progressive Event:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Name="ProgressiveEventTemplateBox" Grid.Row="2" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Non-progressive Event:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Name="NonProgressiveEventTemplateBox" Grid.Row="3" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Peaceful Event:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Name="PeacefulEventTemplateBox" Grid.Row="4" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Weather:" VerticalAlignment="Top" Margin="0,6,0,0" />
          <TextBox Name="WeatherTemplateBox" Grid.Row="5" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="3" Margin="16,0,16,16">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Cancel" Click="OnCancelClick" />
        <Button Name="SaveButton" Content="Save" Click="OnSaveClick" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
