<Window xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  x:Class="TerrariaRPC.Forms.MainWindow"
  Title="Terraria RPC Configuration"
  MinWidth="400"
  MinHeight="550"
  Width="640"
  Height="720"
  WindowStartupLocation="CenterScreen"
  Icon="avares://TerrariaRPC/Assets/icon.png">
  <Grid RowDefinitions="Auto,*,Auto">
    <StackPanel Grid.Row="0" Margin="20,20,20,0" Spacing="12">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="Template" FontWeight="Bold" FontSize="18" VerticalAlignment="Center" />
        <Button Grid.Column="1"
          Content="? Available Variables"
          FontSize="12"
          Padding="8,4"
          Click="OnVariablesClick" />
      </Grid>

      <Grid ColumnDefinitions="*,*" Margin="0,0,0,16">
        <Button Name="MainMenuPaneButton"
          Grid.Column="0"
          Content="Main Menu"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          Margin="0,0,4,0"
          Click="OnMainMenuPaneClick" />
        <Button Name="InGamePaneButton"
          Grid.Column="1"
          Content="In-game"
          HorizontalAlignment="Stretch"
          HorizontalContentAlignment="Center"
          VerticalContentAlignment="Center"
          Margin="4,0,0,0"
          Click="OnInGamePaneClick" />
      </Grid>
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="20,16,20,16" Spacing="16">
        <Grid Name="MainMenuPanel" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuLine1Box" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuLine2Box" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Small Status Image:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuSmallImageUrlBox" Grid.Row="2" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Small Status Text:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuSmallImageTextBox" Grid.Row="3" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Large Status Image:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuLargeImageUrlBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Large Status Text:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="MainMenuLargeImageTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />
        </Grid>

        <Grid Name="InGamePanel" ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" IsVisible="False">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Line 1:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="Line1Box" Grid.Row="0" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Line 2:" VerticalAlignment="Top" Margin="0,6,0,10" />
          <TextBox Name="Line2Box" Grid.Row="1" Grid.Column="1" Margin="0,0,0,10" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" GotFocus="OnMainMenuFieldGotFocus" LostFocus="OnMainMenuFieldLostFocus" />

          <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" ColumnDefinitions="180,*,Auto" Margin="0,0,0,10">
            <TextBlock Grid.Column="0" Text="Small Image &amp; Text Style:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Name="SmallImageStyleBox" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,8,0" SelectionChanged="OnSmallImageStyleChanged">
              <ComboBoxItem Content="Rotatable Lists" />
              <ComboBoxItem Content="Static Status" />
            </ComboBox>
            <Button Grid.Column="2"
              Width="28"
              Height="28"
              Padding="0"
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              ToolTip.Tip="Boss and Event priority options..."
              Click="OnBossEventPriorityClick">
              <TextBlock Text="&#x2699;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Button>
          </Grid>


          <StackPanel Name="SmallStatusListPane" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,0,0,10" Spacing="8">
            <Grid ColumnDefinitions="44,86,*,Auto" Margin="0,0,0,4">
              <TextBlock Grid.Column="0" Text="#" FontWeight="SemiBold" Opacity="0.75" HorizontalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="Enabled" FontWeight="SemiBold" Opacity="0.75" Margin="6,0,0,0" />
              <TextBlock Grid.Column="2" Text="Status Name" FontWeight="SemiBold" Opacity="0.75" />
              <TextBlock Grid.Column="3" Text="Actions" FontWeight="SemiBold" Opacity="0.75" HorizontalAlignment="Right" Margin="0,0,6,0" />
            </Grid>
            <ScrollViewer MaxHeight="220">
              <StackPanel Name="SmallStatusRowsPanel" Spacing="6" />
            </ScrollViewer>
            <Button Name="AddSmallStatusButton" Content="Add New Status" HorizontalAlignment="Stretch" Click="OnAddSmallStatusClick" />
          </StackPanel>

          <TextBlock Name="SmallImageCustomUrlLabel" Grid.Row="4" Grid.Column="0" Text="Image:" VerticalAlignment="Center" Margin="20,0,0,10" IsVisible="False" />
          <TextBox Name="SmallImageCustomUrlBox" Grid.Row="4" Grid.Column="1" Margin="0,0,0,10" IsVisible="False" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />

          <TextBlock Name="SmallImageCustomTextLabel" Grid.Row="5" Grid.Column="0" Text="Text:" VerticalAlignment="Center" Margin="20,0,0,10" IsVisible="False" />
          <TextBox Name="SmallImageCustomTextBox" Grid.Row="5" Grid.Column="1" Margin="0,0,0,10" IsVisible="False" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Large Image &amp; Text Style:" VerticalAlignment="Center" Margin="0,0,0,10" />
          <ComboBox Name="LargeImageStyleBox" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,0,10" SelectionChanged="OnLargeImageStyleChanged">
            <ComboBoxItem Content="Image: Evil-based Tree or Rotating Selected Special/Secret Seed Tree Icons, Text: World Difficulty, Special Seed List and Amount of Secret Seeds" />
            <ComboBoxItem Content="Custom" />
          </ComboBox>

          <TextBlock Name="LargeImageCustomUrlLabel" Grid.Row="7" Grid.Column="0" Text="Image:" VerticalAlignment="Center" Margin="20,0,0,10" IsVisible="False" />
          <TextBox Name="LargeImageCustomUrlBox" Grid.Row="7" Grid.Column="1" Margin="0,0,0,10" IsVisible="False" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />

          <TextBlock Name="LargeImageCustomTextLabel" Grid.Row="8" Grid.Column="0" Text="Text:" VerticalAlignment="Center" Margin="20,0,0,10" IsVisible="False" />
          <TextBox Name="LargeImageCustomTextBox" Grid.Row="8" Grid.Column="1" Margin="0,0,0,10" IsVisible="False" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />
        </Grid>

        <TextBlock Text="Discord" FontWeight="Bold" FontSize="18" />
        <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto" RowSpacing="10">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Update Interval (s):" VerticalAlignment="Center" />
          <TextBox Name="UpdateIntervalBox" Grid.Row="0" Grid.Column="1" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Client ID:" VerticalAlignment="Center" />
          <TextBox Name="ClientIdBox" Grid.Row="1" Grid.Column="1" TextChanged="OnSingleLineTextChanged" PastingFromClipboard="OnSingleLinePastingFromClipboard" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Margin="20,12,20,20">
      <Button Name="SaveButton" Content="Save Configuration" Click="OnSaveClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
  </Grid>
</Window>
