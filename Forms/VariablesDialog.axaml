<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TerrariaRPC.Forms.VariablesDialog"
        Title="Available Template Variables"
        Width="660" Height="520"
        MinWidth="660" MinHeight="520"
        MaxWidth="660" MaxHeight="520"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="avares://TerrariaRPC/Assets/icon.png">
  <!-- Content is built in code-behind to avoid XAML curly-brace conflicts -->
  <Grid Name="RootGrid" RowDefinitions="*,Auto" Margin="16">
    <ScrollViewer Name="ScrollArea" Grid.Row="0"/>
    <Button Grid.Row="1"
            Content="Close"
            HorizontalAlignment="Right"
            Margin="0,12,0,0"
            Click="OnCloseClick"/>
  </Grid>
</Window>
